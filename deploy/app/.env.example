# cp .env.example .env && chmod 600 .env, then change the values.
# Keep a copy in the password manager.

# Full 40-character commit sha of an image CI pushed (docs/infra/runbook.md → Deploy).
IMAGE_TAG=0000000000000000000000000000000000000000
# Previous: (the sha to roll back to)

# The same value as DB_PASSWORD in db's .env.
DB_PASSWORD=change-me
# HS256 signing key, at least 32 bytes. Generate one: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
ADMIN_EMAIL=admin@cinema.local
ADMIN_PASSWORD=change-me

# Addresses on cinema-subnet (Terraform output fixed_ips).
APP_BIND_IP=192.168.100.20
DB_HOST_IP=192.168.100.30
