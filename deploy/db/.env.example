# cp .env.example .env && chmod 600 .env, then change the values.
# Keep a copy in the password manager: a rebuilt db keeps its data but not this file.

# Must stay the password pgdata was created with: changing it here doesn't
# change it in the database.
DB_PASSWORD=change-me
# db's address on cinema-subnet (Terraform output fixed_ips).
DB_BIND_IP=192.168.100.30
