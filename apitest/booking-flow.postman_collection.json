{
  "info": {
    "name": "se-phase-01 booking flow",
    "description": "End-to-end API checks for the booking flow: catalogue, Holds, conflicts, payment, cancellation and refunds, plus access rules and known bugs. Run with Newman (see apitest/README.md). Each run creates its own Cinema, Auditorium, Movie and Customers, so it can run against any database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('no 500 response', () => pm.expect(pm.response.code).to.be.below(500));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Admin logs in",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const run = Date.now();",
              "pm.collectionVariables.set('runId', run);",
              "const day = 24 * 3600 * 1000;",
              "pm.collectionVariables.set('startsAt', new Date(run + 30 * day).toISOString());",
              "pm.collectionVariables.set('startsAt2', new Date(run + 32 * day).toISOString());",
              "pm.collectionVariables.set('emailA', `newman-a-${run}@example.com`);",
              "pm.collectionVariables.set('emailB', `newman-b-${run}@example.com`);"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 with a token', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().accessToken).to.be.a('string'); });",
              "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Customer A registers",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{emailA}}\",\"password\":\"password123\",\"fullName\":\"Customer A\"}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Registering the same email again is a conflict",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{emailA}}\",\"password\":\"password123\",\"fullName\":\"Customer A\"}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Customer A logs in",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('tokenA', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{emailA}}\",\"password\":\"password123\"}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Customer B registers",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{emailB}}\",\"password\":\"password123\",\"fullName\":\"Customer B\"}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Customer B logs in",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('tokenB', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{emailB}}\",\"password\":\"password123\"}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Access rules",
      "item": [
        {
          "name": "Listing Bookings needs a token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/bookings" }
        },
        {
          "name": "A Customer cannot create a Cinema",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Not allowed {{runId}}\",\"address\":\"Nowhere\"}" },
            "url": "{{baseUrl}}/api/cinemas"
          }
        }
      ]
    },
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "Admin creates a Cinema",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('cinemaId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Newman Cinema {{runId}}\",\"address\":\"1 Test Street\"}" },
            "url": "{{baseUrl}}/api/cinemas"
          }
        },
        {
          "name": "Admin creates an Auditorium",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('auditoriumId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Screen 1\",\"rows\":5,\"seatsPerRow\":8,\"vipRows\":[\"D\"],\"coupleRows\":[\"E\"]}" },
            "url": "{{baseUrl}}/api/cinemas/{{cinemaId}}/auditoriums"
          }
        },
        {
          "name": "Admin creates a Movie",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('movieId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"title\":\"Newman {{runId}}\",\"description\":\"A test movie.\",\"durationMinutes\":120,\"genre\":\"Drama\",\"ageRating\":\"T13\",\"releaseDate\":\"2026-05-01\",\"posterUrl\":\"https://example.com/poster.jpg\"}" },
            "url": "{{baseUrl}}/api/movies"
          }
        },
        {
          "name": "Admin creates a Showtime",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('showtimeId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"movieId\":\"{{movieId}}\",\"auditoriumId\":\"{{auditoriumId}}\",\"startsAt\":\"{{startsAt}}\",\"basePrice\":100000}" },
            "url": "{{baseUrl}}/api/showtimes"
          }
        }
      ]
    },
    {
      "name": "Booking",
      "item": [
        {
          "name": "Anyone opens the seat map",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const seats = pm.response.json();",
            "pm.test('200, every Seat available', () => { pm.response.to.have.status(200); pm.expect(seats.length).to.be.above(0); pm.expect(seats.every(s => s.status === 'AVAILABLE')).to.be.true; });",
            "const rowA = seats.filter(s => String(s.label).startsWith('A')).map(s => s.id);",
            "pm.test('row A has at least three Seats', () => pm.expect(rowA.length).to.be.at.least(3));",
            "pm.collectionVariables.set('seat1', rowA[0]);",
            "pm.collectionVariables.set('seat2', rowA[1]);",
            "pm.collectionVariables.set('seat3', rowA[2]);"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/showtimes/{{showtimeId}}/seats" }
        },
        {
          "name": "Customer A holds two Seats",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const b = pm.response.json();",
            "pm.test('201 Pending, two Seats, 200000', () => { pm.response.to.have.status(201); pm.expect(b.status).to.eql('PENDING'); pm.expect(b.seats).to.have.length(2); pm.expect(b.totalPrice).to.eql(200000); });",
            "pm.collectionVariables.set('bookingA', b.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"showtimeId\":\"{{showtimeId}}\",\"seatIds\":[\"{{seat1}}\",\"{{seat2}}\"]}" },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "Customer B cannot hold a held Seat",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409 problem+json naming the Seat', () => { pm.response.to.have.status(409); pm.expect(pm.response.headers.get('Content-Type')).to.include('problem+json'); pm.expect(pm.response.json().seatIds).to.include(pm.collectionVariables.get('seat1')); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenB}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"showtimeId\":\"{{showtimeId}}\",\"seatIds\":[\"{{seat1}}\"]}" },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "Customer A cannot have a second Pending Booking",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"showtimeId\":\"{{showtimeId}}\",\"seatIds\":[\"{{seat3}}\"]}" },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "Customer B cannot read Customer A's Booking",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403 or 404', () => pm.expect(pm.response.code).to.be.oneOf([403, 404]));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }],
            "url": "{{baseUrl}}/api/bookings/{{bookingA}}"
          }
        },
        {
          "name": "Customer A pays",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 Confirmed', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('CONFIRMED'); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{baseUrl}}/api/bookings/{{bookingA}}/payment"
          }
        },
        {
          "name": "Paying again returns the same Booking",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 Confirmed', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('CONFIRMED'); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{baseUrl}}/api/bookings/{{bookingA}}/payment"
          }
        },
        {
          "name": "The paid Seats show as sold",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const sold = pm.response.json().filter(s => s.status !== 'AVAILABLE');",
            "pm.test('exactly the two Seats are SOLD', () => { pm.expect(sold.map(s => s.id).sort()).to.eql([pm.collectionVariables.get('seat1'), pm.collectionVariables.get('seat2')].sort()); pm.expect(sold.every(s => s.status === 'SOLD')).to.be.true; });"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/showtimes/{{showtimeId}}/seats" }
        }
      ]
    },
    {
      "name": "Cancellation",
      "item": [
        {
          "name": "Admin cancels the Showtime",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"reason\":\"EQUIPMENT_FAILURE\",\"note\":\"Newman run {{runId}}\"}" },
            "url": "{{baseUrl}}/api/showtimes/{{showtimeId}}/cancellation"
          }
        },
        {
          "name": "Customer A's Booking is Refunded",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Refunded', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('REFUNDED'); });"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{baseUrl}}/api/bookings/{{bookingA}}"
          }
        },
        {
          "name": "A Cancelled Showtime takes no Booking",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenB}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"showtimeId\":\"{{showtimeId}}\",\"seatIds\":[\"{{seat3}}\"]}" },
            "url": "{{baseUrl}}/api/bookings"
          }
        }
      ]
    },
    {
      "name": "Known bugs (phase 2)",
      "description": "Each request here fails today and documents one entry of docs/phase2/problem-register.md. It passes once the bug is fixed.",
      "item": [
        {
          "name": "B1: a basePrice whose VIP or Couple price overflows is rejected",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 at creation', () => pm.response.to.have.status(400));",
            "if (pm.response.code === 201) pm.collectionVariables.set('overflowShowtimeId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"movieId\":\"{{movieId}}\",\"auditoriumId\":\"{{auditoriumId}}\",\"startsAt\":\"{{startsAt2}}\",\"basePrice\":4611686018427387904}" },
            "url": "{{baseUrl}}/api/showtimes"
          }
        },
        {
          "name": "B1: the seat map of such a Showtime does not fail with 500",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "if (!pm.collectionVariables.get('overflowShowtimeId')) pm.execution.skipRequest();"
            ] } }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/showtimes/{{overflowShowtimeId}}/seats" }
        }
      ]
    }
  ]
}
